@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <nav class="nav">
        <span class="nav-text">@UserManager.GetUserName(User)</span>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm" style="display: inline;">
            <button type="submit" class="btn btn-secondary btn-small">Logout</button>
        </form>
    </nav>
}
else
{
    <nav class="nav">
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-secondary btn-small">Login</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-small">Register</a>
    </nav>
}