@page
@model VerifyModel

@{
    ViewData["Title"] = "Verify Phone Number";
}

<div class="card">
    <h1 class="card-title">Verify Your Phone</h1>
    <p class="mb-60">Enter the verification code sent to your phone number.</p>

    <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="All" class="alert alert-error"></div>

        <div class="form-group">
            <label asp-for="Input.Code" class="form-label">Verification Code</label>
            <input asp-for="Input.Code" class="form-control verification-code-input" maxlength="6" placeholder="000000"/>
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-full-width">Verify Code</button>
    </form>

    <hr class="divider" />

    <div>
        <h3 class="mb-60">Didn't receive the code?</h3>
        <div class="form-group">
            <label class="form-label">Resend via:</label>
            <div class="radio-group">
                <label class="radio-label">
                    <input name="channel" type="radio" value="sms" checked="checked"/>
                    <span>SMS</span>
                </label>
                <label class="radio-label">
                    <input name="channel" type="radio" value="call"/>
                    <span>Call</span>
                </label>
            </div>
        </div>
        <button type="button" id="resend" class="btn btn-secondary btn-full-width">Resend Code</button>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript">
    $(document).ready(function(){
        $(document).on('click', 'button#resend', function(){
            $.ajax({
                url: '@Url.Content("~/api/Verify")',
                method: 'POST',
                data: {
                  channel: $('input[name=channel]:checked').val()
                },
                success: function(result) {
                    if(result.isValid === true) {
                        showMessage('New code sent to your phone number', 'success');
                    } else {
                        showMessage(result.errors.join(', '), 'error');
                    }
                },
                error: function() {
                    showMessage('Request failed: check your internet connection', 'error');
                }
            })
        });
    });
    function showMessage(message, type) {
        $('#messages').html(
            '<div class="alert alert-' + type + '">' + message + '</div>'
        );
    }
    </script>
}

